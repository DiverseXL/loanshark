{
  "name": "@loanshark/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LOANSHARK diagnostics surface: wallet detection, chain guard and QoreX message signing, browser only.",
  "scripts": {
    "predev": "pnpm --filter @loanshark/chain-client build",
    "dev": "vite",
    "prebuild": "pnpm --filter @loanshark/chain-client build",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "pretypecheck": "pnpm --filter @loanshark/chain-client build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --strictPort"
  },
  "dependencies": {
    "@loanshark/chain-client": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
