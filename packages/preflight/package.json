{
  "name": "@loanshark/preflight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only transaction preflight for LOANSHARK settlement actions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@loanshark/privacy-footprint": "workspace:*",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
