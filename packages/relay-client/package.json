{
  "name": "@loanshark/relay-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed, verifying client for the LOANSHARK ephemeral relay server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@loanshark/agreement": "workspace:*",
    "@loanshark/api": "workspace:*",
    "@loanshark/chain-client": "workspace:*",
    "@loanshark/qoreseal-adapter": "workspace:*",
    "@loanshark/seal-account": "workspace:*",
    "@qorechain/qoreseal": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
